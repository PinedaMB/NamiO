<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

const mm = gsap.matchMedia();
mm.add('(prefers-reduced-motion: no-preference)', () => {
  const hero = document.querySelectorAll('main section:first-of-type > *');
  gsap.from(hero, { y: 24, opacity: 0, duration: 0.8, stagger: 0.12, ease: 'power3.out' });


  document.querySelectorAll<HTMLElement>('main section:not(:first-of-type):not(#historia)').forEach((section) => {
    const grid = section.querySelector(':scope > .grid');
    const blocks = Array.from(section.children).filter((el) => el !== grid);
    if (blocks.length) {
      gsap.from(blocks, {
        y: 32, opacity: 0, duration: 0.8, stagger: 0.12, ease: 'power3.out',
        scrollTrigger: { trigger: section, start: 'top 80%', once: true },
      });
    }
    if (grid) {
      gsap.from(grid.children, {
        y: 40, opacity: 0, duration: 0.7, stagger: 0.1, ease: 'power3.out',
        scrollTrigger: { trigger: grid, start: 'top 85%', once: true },
      });
    }
  });
});
mm.add('(prefers-reduced-motion: no-preference)', () => {
    const story = document.querySelector<HTMLElement>('#historia');
    const chapters = gsap.utils.toArray<HTMLElement>('[data-chapter]');
    if (story && chapters.length > 1) {
      story.classList.add('is-pinned');
      gsap.set(chapters, { autoAlpha: 0 });
      gsap.set(chapters[0], { autoAlpha: 1 });
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: story, start: 'top top+=64', end: () => `+=${chapters.length * 80}%`, scrub: 0.6, pin: true, pinSpacing: true, invalidateOnRefresh: true },
      });
      const steps = gsap.utils.toArray<HTMLElement>('[data-step]');
      gsap.set(steps[0], { opacity: 1 });
      tl.to('[data-story-bar]', { scaleX: 1, duration: chapters.length - 1 }, 0);
      chapters.forEach((ch, i) => {
        const copy = ch.querySelector('.story-copy');
        const visual = ch.querySelector('[data-visual]');
        const cards = ch.querySelectorAll('.sv-row, .sv-field, .sv-lines i, .sv-actions');
        if (i > 0) {
          tl.to(chapters[i - 1], { autoAlpha: 0, duration: 0.3 }, i - 0.4)
            .to(steps[i], { opacity: 1, duration: 0.3 }, i - 0.1)
            .fromTo(ch, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.3 }, i - 0.1)
            .fromTo(copy, { y: 60 }, { y: 0, duration: 0.5 }, i - 0.1)
            .fromTo(visual, { y: 80, rotateY: -14, scale: 0.92 }, { y: 0, rotateY: 0, scale: 1, duration: 0.6 }, i - 0.1)
            .fromTo(cards, { x: 24, autoAlpha: 0 }, { x: 0, autoAlpha: 1, stagger: 0.06, duration: 0.3 }, i + 0.1);
        }
      });
      tl.to({}, { duration: 0.3 });
      return () => story.classList.remove('is-pinned');
    }
});
</script>
