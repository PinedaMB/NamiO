<script>
  import { updateRelease } from '../lib/releases.js';
  void updateRelease(document);
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { revealOnScroll } from '../lib/reveal.js';
import { createStoryPlayer } from '../lib/story.js';

gsap.registerPlugin(ScrollTrigger);

const mm = gsap.matchMedia();
mm.add('(prefers-reduced-motion: no-preference)', () => {
  // El contenido sigue visible aunque no se active su animación de entrada.
  const hero = document.querySelectorAll('main [data-hero] > *');
  gsap.from(hero, { y: 24, immediateRender: false, duration: 0.8, stagger: 0.12, ease: 'power3.out' });

});
mm.add('(prefers-reduced-motion: no-preference)', () => {
    const story = document.querySelector<HTMLElement>('#historia');
    const chapters = gsap.utils.toArray<HTMLElement>('[data-chapter]');
    if (story && chapters.length > 1) {
      story.classList.add('is-pinned');
      gsap.set(chapters, { autoAlpha: 0 });
      gsap.set(chapters[0], { autoAlpha: 1 });
      const steps = gsap.utils.toArray<HTMLElement>('[data-step]');
      const { showChapter, cleanup } = createStoryPlayer(gsap, chapters, steps);
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: story, start: 'top top+=64', end: () => `+=${chapters.length * 80}%`,
          scrub: 0.6, pin: true, pinSpacing: true, invalidateOnRefresh: true,
          onUpdate: self => showChapter(Math.round(self.progress * (chapters.length - 1))),
        },
      });
      showChapter(0);
      tl.to('[data-story-bar]', { scaleX: 1, duration: chapters.length - 1 }, 0);
      return () => { cleanup(); story.classList.remove('is-pinned'); };
    }
});
mm.add('(prefers-reduced-motion: no-preference)', () => revealOnScroll(gsap));
// Las fuentes locales y el capítulo fijado cambian las posiciones de las secciones.
void document.fonts.ready.then(() => ScrollTrigger.refresh());
window.addEventListener('pageshow', () => ScrollTrigger.refresh());
</script>
</body>
