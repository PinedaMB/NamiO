</a>
</nav>
</div>

<div class="bg-surface-container p-2.5 rounded-xl flex items-center justify-between text-on-surface-variant">
<span class="font-label-sm text-label-sm flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-tertiary" aria-hidden="true">wifi</span>
                Modo Offline Listo
              </span>
<span class="font-label-sm text-[10px] text-outline font-code-kbd">24.3 MB</span>
</div>
</div>

<div class="col-span-1 md:col-span-4 lg:col-span-4 bg-surface-container p-3 flex flex-col justify-between">
