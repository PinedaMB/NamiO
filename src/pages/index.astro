<input class="bg-transparent text-xs w-full text-on-surface placeholder:text-outline focus:outline-none" placeholder="Buscar correos ( / )..." readonly="" type="text" value="from:equipo"/>
<kbd class="bg-surface-container text-outline px-1.5 py-0.5 rounded font-code-kbd text-[10px]">ESC</kbd>
</div>

