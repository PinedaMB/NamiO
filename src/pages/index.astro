            </span>
<span class="bg-surface-container-highest px-1.5 py-0.5 rounded font-code-kbd text-code-kbd">⌘K Omnibar</span>
</div>
</div>

<div class="grid grid-cols-1 md:grid-cols-12 bg-surface-dim rounded-b-xl min-h-[580px] overflow-hidden">

<div class="hidden md:flex md:col-span-3 lg:col-span-2 bg-surface-container-low p-3 flex-col justify-between">
<div class="space-y-4">

<div class="bg-surface-container p-2.5 rounded-xl space-y-1">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-on-surface-variant font-semibold uppercase tracking-wider">Cuentas</span>
<span class="w-2 h-2 rounded-full bg-primary" title="Cuenta activa sincronizada"></span>
</div>
<div class="flex items-center gap-2 pt-1 text-on-surface">
<div class="w-6 h-6 rounded-md bg-primary-container text-on-primary-container font-bold flex items-center justify-center text-xs">P</div>
<div class="truncate">
<p class="font-body-sm text-body-sm font-medium leading-none truncate">personal@gmail.com</p>
<span class="font-label-sm text-[10px] text-on-surface-variant">OAuth2 · En línea</span>
</div>
</div>
<div class="flex items-center gap-2 pt-1 text-on-surface-variant opacity-70 hover:opacity-100 transition-opacity cursor-pointer">
<div class="w-6 h-6 rounded-md bg-surface-container-highest text-on-surface font-bold flex items-center justify-center text-xs">T</div>
<div class="truncate">
<p class="font-body-sm text-body-sm leading-none truncate">juan@empresa.com</p>
