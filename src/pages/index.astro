<div class="bg-surface-container-high px-4 py-2.5 rounded-t-xl flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="w-3 h-3 rounded-full bg-error opacity-80"></span>
<span class="w-3 h-3 rounded-full bg-[#fbbc04] opacity-80"></span>
<span class="w-3 h-3 rounded-full bg-[#34a853] opacity-80"></span>
<div class="ml-4 flex items-center gap-2">
<img class="w-4 h-4 rounded-full object-cover" alt="" src={asset("logo.png")}/>
<span class="font-headline-sm text-[12px] text-on-surface font-medium tracking-tight">NamiO — tu correo, a tu ritmo</span>
</div>
</div>
<div class="flex items-center gap-3 text-on-surface-variant font-label-sm text-label-sm">
<span class="hidden sm:inline-flex items-center gap-1.5 bg-surface-container px-2 py-0.5 rounded text-primary">
<span class="w-1.5 h-1.5 rounded-full bg-primary animate-ping"></span>
