---
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path}`;
---
<!doctype html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="NamiO, tu correo a tu ritmo. Cliente de correo de escritorio con varias cuentas, borradores, lectura sin conexión y notificaciones." />
  <meta name="theme-color" content="#0f131c" />
  <meta property="og:title" content="NamiO — Tu correo, a tu ritmo" />
  <meta property="og:description" content="Leé, escribí y organizá tus mensajes con varias cuentas, acceso sin conexión y control sobre tus datos." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(asset('logo.png'), Astro.site).href} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" type="image/png" href={asset('logo.png')} />
  <title>NamiO — Tu correo, a tu ritmo</title>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">
<a href="#contenido" class="skip-link">Saltar al contenido</a>
<header class="fixed top-0 left-0 w-full z-50 bg-surface-container-lowest/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.4)]"><div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between"><div class="flex items-center gap-space-md"><a aria-label="NamiO, inicio" class="flex items-center gap-space-sm group" href="#contenido"><img alt="NamiO" class="w-8 h-8 rounded-full object-cover" src={asset("logo.png")}/><span class="font-headline-sm text-headline-sm text-on-surface tracking-tight group-hover:text-primary transition-colors">NamiO</span></a><span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-space-sm py-0.5 rounded-lg">v0.4.0</span></div><nav class="hidden md:flex items-center gap-space-lg" data-active-classes="text-primary font-medium"><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#funciones">Funciones</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#sin-conexion">Sin conexión</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#privacidad">Privacidad</a><a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href="#descargas">Descargas</a></nav><details class="mobile-menu"><summary aria-label="Abrir menú de navegación"><span></span><span></span><span></span></summary><nav aria-label="Navegación móvil"><a href="#funciones">Funciones</a><a href="#sin-conexion">Sin conexión</a><a href="#privacidad">Privacidad</a><a href="#descargas">Descargas</a></nav></details><div class="header-cta flex items-center gap-space-md"><a class="inline-flex items-center justify-center bg-primary-container hover:bg-primary text-on-primary-container hover:text-on-primary font-body-sm text-body-sm px-space-md py-space-sm rounded-lg transition-colors font-medium shadow-[0_1px_4px_rgba(0,0,0,0.3)]" href="#descargas">Descargar NamiO</a></div></div></header><main tabindex="-1" id="contenido" class="w-full pt-16 bg-surface min-h-[calc(100vh-140px)]"><div class="flex flex-col w-full">

<div class="relative w-full overflow-hidden">
<div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[340px] bg-primary-container/15 blur-[120px] pointer-events-none rounded-full"></div>
<div class="absolute top-96 -left-24 w-[420px] h-[280px] bg-secondary-container/20 blur-[100px] pointer-events-none rounded-full"></div>

<section class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-12 pb-16 lg:pt-16 lg:pb-24 flex flex-col items-center text-center">

<div class="inline-flex items-center gap-2 bg-surface-container-high px-3 py-1.5 rounded-full mb-8 shadow-sm">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
<span class="font-label-sm text-label-sm text-primary tracking-wider uppercase">v0.4.0 EN DESARROLLO · CÓDIGO ABIERTO · ESPAÑOL / ENGLISH</span>
</div>

<h1 class="font-headline-lg text-4xl sm:text-5xl lg:text-6xl text-on-surface font-bold tracking-tight max-w-4xl mx-auto leading-tight">
        Tu correo, <span class="text-primary">a tu ritmo.</span>
</h1>

<p class="mt-6 font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        Un cliente de correo de escritorio para leer, escribir y organizar tus mensajes a tu ritmo. Varias cuentas, lectura sin conexión y control sobre tus datos en una interfaz oscura y cuidada.
      </p>

<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
<a class="group inline-flex items-center gap-3 bg-primary hover:bg-primary-fixed text-on-primary font-headline-sm text-headline-sm px-6 py-3.5 rounded-xl shadow-lg transition-all duration-200" href="#descargas">
<span class="material-symbols-outlined text-[20px]" aria-hidden="true">download</span>
<span>Explorar descargas</span>
<span class="bg-on-primary/15 text-on-primary font-label-sm text-label-sm px-2 py-0.5 rounded-md">AppImage · .deb</span>
</a>
<a class="group inline-flex items-center gap-2.5 bg-surface-container hover:bg-surface-container-high text-on-surface font-body-md text-body-md px-5 py-3.5 rounded-xl shadow-sm transition-all duration-200" href="https://github.com/PinedaMB/NamiO" rel="noreferrer" target="_blank">
<svg class="w-5 h-5 fill-current text-on-surface-variant group-hover:text-primary transition-colors" viewbox="0 0 24 24">
<path clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" fill-rule="evenodd"></path>
</svg>
<span>Ver código en GitHub</span>
<span class="bg-surface-container-highest text-on-surface-variant font-label-sm text-label-sm px-2 py-0.5 rounded">Licencia MIT</span>
</a>
</div>

<div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-on-surface-variant font-body-sm text-body-sm">
<span class="inline-flex items-center gap-2">
<span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">verified_user</span>
          Imágenes remotas bloqueadas
        </span>
<span class="text-surface-bright hidden sm:inline">•</span>
<span class="inline-flex items-center gap-2">
<span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">hard_drive_2</span>
          Mensajes guardados en tu equipo
        </span>
<span class="text-surface-bright hidden sm:inline">•</span>
<span class="inline-flex items-center gap-2">
<span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">lan</span>
          Conexión estándar IMAP &amp; SMTP
