<span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px]" aria-hidden="true">star</span> Destacados</span>
</a>
<a class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" href="#">
<span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px]" aria-hidden="true">draft</span> Borradores</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">3</span>
</a>
<a class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" href="#">
<span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px]" aria-hidden="true">send</span> Enviados</span>
</a>
