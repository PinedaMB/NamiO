{
  "name": "namio",
  "version": "0.1.0",
  "productName": "NamiO",
  "description": "NamiO — cliente de correo de escritorio para Linux",
  "main": "./out/main/index.js",
  "author": {
    "name": "linux-mail-client",
    "email": "dev@example.com"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "dev:restricted": "node scripts/dev.mjs --force-unsandboxed",
    "preview": "node scripts/preview.mjs",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build": "pnpm run typecheck && electron-vite build",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:win": "pnpm run build && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "material-symbols": "^0.48.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
