{
  "name": "namio",
  "version": "1.0.0-rc.1",
  "productName": "NamiO",
  "description": "NamiO — cliente de correo de escritorio multiplataforma",
  "main": "./out/main/index.js",
  "author": {
    "name": "PinedaMB",
    "email": "mendez-pineda@outlook.es"
  },
  "license": "MIT",
  "homepage": "https://github.com/PinedaMB/NamiO",
  "desktopName": "namio.desktop",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:ui": "pnpm run build && node scripts/test.mjs --ui",
    "dev": "node scripts/dev.mjs",
    "dev:raw": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "dev:restricted": "node scripts/dev.mjs --force-unsandboxed",
    "preview": "node scripts/preview.mjs",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "css:audit": "node scripts/css-audit.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "build": "pnpm run licenses:generate && pnpm run typecheck && electron-vite build",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:win": "pnpm run build && electron-builder --win",
    "pack:dir": "pnpm run build && electron-builder --linux dir --publish never",
    "pack:inspect": "node scripts/asar-inspect.cjs release/linux-unpacked/resources/app.asar"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hoodiecrow-imap": "^3.3.1",
    "material-symbols": "^0.48.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "typescript-test": "npm:typescript@^5.9.3",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PinedaMB/NamiO.git"
  },
  "bugs": {
    "url": "https://github.com/PinedaMB/NamiO/issues"
  }
}
